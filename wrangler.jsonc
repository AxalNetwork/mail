{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mail",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Every `wrangler deploy` (GitHub Actions, Cloudflare Workers Builds, or by
  // hand) builds the frontend into dist/ first.
  "build": { "command": "npx vite build", "watch_dir": "src" },

  // Frontend: the Vite build. Cloudflare serves these files directly; only
  // /api/* runs the Worker. Unknown paths fall back to index.html (SPA).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Creates the mail.axal.vc DNS record and certificate on deploy.
  // Requires the axal.vc zone to be in this Cloudflare account.
  "routes": [{ "pattern": "mail.axal.vc", "custom_domain": true }],
  // The workers.dev address lets the deploy check reach the Worker past the
  // zone's bot protection; sign-in only works on mail.axal.vc (OAuth origin).
  "workers_dev": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "axal-mail",
      "database_id": "e7e9fb33-b869-4dae-9a3c-176c611a9591",
      "migrations_dir": "worker/migrations"
    }
  ],

  // keep_vars stops a deploy from erasing variables set in the dashboard.
  "keep_vars": true,
  "vars": {
    "ALLOWED_DOMAINS": "axal.vc",
    "ORG_DOMAIN": "axal.vc",
    // OAuth Web client for sign-in (public: every visitor's browser receives it)
    "GOOGLE_CLIENT_ID": "1073989004951-k2e595rrk1o2l38gb4c3lbdkn7egin0d.apps.googleusercontent.com",
    // Full rights in Administration, including granting admin; can't be suspended from the app
    "SUPER_ADMINS": "guillaume.lauzier@axal.vc",
    // StudioOS, for the Mail link (lists, testers and testing programmes)
    "STUDIOOS_BASE_URL": "https://axal.vc"
  },
  // Secrets (wrangler secret put): ANTHROPIC_API_KEY

  // Outreach sequences: send due follow-up steps every 10 minutes.
  "triggers": { "crons": ["*/10 * * * *"] },

  "observability": { "enabled": true }
}
