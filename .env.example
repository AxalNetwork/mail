# Frontend-only development settings. When the app is served by the Worker
# (npm run dev:api, or production), these come from /api/config instead.

# OAuth 2.0 Web client ID from Google Cloud Console (APIs & Services → Credentials).
# Leave empty to run the app in demo mode with fictional data.
VITE_GOOGLE_CLIENT_ID=

# Domain treated as "internal" for external-recipient warnings.
# Defaults to the connected account's domain (ignored for consumer domains like gmail.com).
VITE_ORG_DOMAIN=

# Optional assistant backend base URL (summaries, drafts, rewrites). See README → Backend API.
VITE_ASSISTANT_URL=
